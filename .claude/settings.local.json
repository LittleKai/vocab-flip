{
  "permissions": {
    "allow": [
      "Bash(flutter analyze:*)",
      "Bash(flutter clean:*)",
      "Bash(flutter pub get:*)",
      "Bash(flutter run:*)",
      "Bash(tree:*)",
      "Bash(flutter gen-l10n:*)",
      "Bash(powershell -Command \"Get-ChildItem -Recurse -Filter ''*.dart'' lib/presentation/screens | ForEach-Object { \\(Get-Content $_FullName\\) -replace \"\"import ''package:flutter_gen/gen_l10n/app_localizations.dart''\"\", \"\"import ''package:vocabflip/l10n/app_localizations.dart''\"\" | Set-Content $_FullName }\")",
      "Bash(dir:*)"
    ]
  },
  "capabilities": {
    "edit": {
      "allowed": true,
      "requiresApproval": false
    },
    "write": {
      "allowed": true,
      "requiresApproval": false
    },
    "read": {
      "allowed": true
    },
    "bash": {
      "allowed": true,
      "requiresApproval": false,
      "allowedCommands": [
        "flutter clean",
        "flutter pub get",
        "flutter build",
        "flutter analyze",
        "flutter run",
        "flutter test",
        "flutter gen-l10n",
        "dart format",
        "dart fix --apply"
      ]
    }
  },
  "autoApprove": {
    "edit": [
      "**/*.md",
      "**/*.dart",
      "**/*.yaml",
      "**/*.json",
      "**/*.arb"
    ],
    "write": [
      "**/*.md",
      "**/*.dart",
      "**/*.yaml",
      "**/*.json",
      "**/*.arb"
    ]
  }
}
