# Firebase Configuration
# Copy this file to .env and fill in your values

# Web
FIREBASE_WEB_API_KEY=your_web_api_key
FIREBASE_WEB_APP_ID=your_web_app_id
FIREBASE_WEB_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_WEB_PROJECT_ID=your_project_id
FIREBASE_WEB_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_WEB_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_WEB_MEASUREMENT_ID=your_measurement_id

# Android
FIREBASE_ANDROID_API_KEY=your_android_api_key
FIREBASE_ANDROID_APP_ID=your_android_app_id

# Windows (uses web config)
FIREBASE_WINDOWS_APP_ID=your_windows_app_id
FIREBASE_WINDOWS_MEASUREMENT_ID=your_windows_measurement_id

# Google Drive Backup (Desktop OAuth)
# Create a Desktop OAuth client ID in Google Cloud Console:
# 1. Go to APIs & Services → Credentials
# 2. Create Credentials → OAuth client ID
# 3. Application type: Desktop app
# 4. Copy both Client ID and Client Secret here
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# Cloudinary Image Hosting (for sharing images in public library)
# Create a free account at https://cloudinary.com
# Go to Settings → Upload → Upload presets → Add preset with "Unsigned" signing mode
# Multiple accounts supported for load balancing (comma-separated)
# Format: cloud_name1,cloud_name2  and  preset1,preset2
CLOUDINARY_CLOUD_NAMES=your_cloudinary_cloud_names
CLOUDINARY_UPLOAD_PRESETS=your_cloudinary_upload_presets

# Public Deck Builder / Publisher Credentials
PUBLISHER_EMAIL=your_email@example.com
PUBLISHER_PASSWORD=your_password


